# ==============================================================================
# FAKE UPI SHIELD - BACKEND ENVIRONMENT CONFIGURATION
# Copy this file to `backend/.env` and update with your local credentials.
# ==============================================================================

# Application Settings
APP_NAME="Fake UPI Shield Backend"
APP_ENV="development"
DEBUG=true
PORT=8000
HOST="127.0.0.1"
CORS_ORIGINS="http://localhost:3000,http://127.0.0.1:3000"

# MySQL Database Settings
DB_HOST="127.0.0.1"
DB_PORT=3306
DB_NAME="fake_upi_detector"
DB_USER="root"
DB_PASSWORD="change_me"
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10

# Tesseract OCR Configuration
# Windows Default: "C:\\Program Files\\Tesseract-OCR\\tesseract.exe"
# Linux Default: "/usr/bin/tesseract"
TESSERACT_CMD="C:\\Program Files\\Tesseract-OCR\\tesseract.exe"

# Machine Learning CNN Settings
MODEL_WEIGHTS_PATH="backend/app/ml/weights/fake_upi_cnn_active.keras"
CLASS_MAPPING_PATH="backend/app/ml/weights/class_mapping.json"
DATASET_ROOT="data/dataset"

# Upload and Storage Rules
MAX_UPLOAD_SIZE_MB=10
ALLOWED_IMAGE_EXTENSIONS="jpg,jpeg,png,webp"
KEEP_ORIGINAL_SCREENSHOTS=false
